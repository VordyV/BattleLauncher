<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="540" d:DesignHeight="450"
             Background="Transparent"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:c="clr-namespace:BLApp.Controls"
             Width="540"
             x:Class="BLApp.Forms.SimpInst">
    <c:Form Title="Simple installation" SubTitle="Adding a path to an already installed game" Width="540">
        <c:Form.Content>
            <StackPanel Spacing="8">
                <TextBlock Text="Game directory" Foreground="#B1B1B1"/>
                <u:PathPicker Name="PathPickerGamePath" Title="OVERVIEW" UsePickerType="OpenFolder"/>
                <TextBlock Name="TextBlockError" Text="" Foreground="#f54e4e" IsVisible="False"/>
            </StackPanel>
        </c:Form.Content>
        <c:Form.ActionContent>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Name="ButtonCancel" Click="ButtonCancel_OnClick" Content="Cancel"/>
                <Button Name="ButtonSave" Click="ButtonSave_OnClick" Content="Save" Classes="Primary" Theme="{StaticResource SolidButton}"/>
            </StackPanel>
        </c:Form.ActionContent>
    </c:Form>
</UserControl>
